# Copie este arquivo para .env.local no desenvolvimento.
# Na Hostinger, defina as mesmas chaves no hPanel (Node.js web app → Environment variables).
# Nenhuma destas variáveis deve ser prefixada com NEXT_PUBLIC_.

# Diagnóstico MySQL (somente servidor). Desabilitado por padrão.
DIAGNOSTICO_ENABLED=false
DIAGNOSTICO_TOKEN=

# Banco MySQL exclusivo de teste desta aplicação.
# Não use credenciais, hostname ou banco da ERP.
MYSQL_HOST=
MYSQL_PORT=3306
MYSQL_USER=
MYSQL_PASSWORD=
MYSQL_DATABASE=
